MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/valueplus?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_minimum_64_chars_long_change_this_to_something_random
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Email Service
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# SMS Gateway (for real SIM OTP delivery in India)
# Option 1: Fast2SMS (Get API key from https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: Twilio SMS (Get credentials from https://twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Option 3: 2Factor.in (Get API key from https://2factor.in)
TWO_FACTOR_API_KEY=your_2factor_api_key
